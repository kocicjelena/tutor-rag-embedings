# Copy to `.env` and edit. `.env` is gitignored.
#   cp .env.example .env

# ─── Security ──────────────────────────────────────────────
# REQUIRED. The app refuses to start with the placeholder value.
# Generate one:  python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=changethis

ENVIRONMENT=local

# ─── Bootstrap accounts ────────────────────────────────────
# Created on startup if missing. There is no public signup route, so without
# these you cannot log in at all.
#
# Matched by EMAIL. Changing an address here does not rename anyone — it adds
# a second account on the next start and leaves the old one untouched. Renaming
# is a deliberate act, not a config edit.
#
# Put real addresses HERE (this file's sibling `.env`, which is gitignored),
# never in `app/core/config.py` — that file is committed.
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=changethis

# The demo account — an ordinary user, not a superuser. The one that shows the
# app off: upload, ask, learn with the tutor, export a model. It exists because
# there is no public signup, so a visitor needs a way in.
# Leave DEMO_USER empty to switch it off entirely.
DEMO_USER=
DEMO_USER_PASSWORD=changethis

# ─── Database ──────────────────────────────────────────────
# SQLite file, relative to the repo root. No server required.
SQLITE_PATH=./rag.db

# ─── Embeddings (never Anthropic — it has no embeddings API) ───
# Requires:  ollama pull nomic-embed-text
OLLAMA_HOST=http://127.0.0.1:11434
# Local models on CPU can take minutes for a long answer.
OLLAMA_TIMEOUT_SECONDS=600

# Which embedding backend: ollama | sentence_transformers
# `sentence_transformers` needs `uv sync --extra local-embed` (~2 GB of torch)
# and has no Ollama requirement — the option for a host that cannot run one.
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=768
# For sentence-transformers instead:
#   EMBEDDING_PROVIDER=sentence_transformers
#   EMBEDDING_MODEL=all-MiniLM-L6-v2
#   EMBEDDING_DIMENSIONS=384
#
# Changing model or dimension does not corrupt anything — each width has its
# own index — but documents indexed under the old model become UNSEARCHABLE.
# The documents list marks them, and this puts them back:
#   uv run python -m app.scripts.reembed --dry-run
#   uv run python -m app.scripts.reembed

# ─── Generation ────────────────────────────────────────────
# Which provider answers when the request doesn't name one: ollama | claude
DEFAULT_CHAT_PROVIDER=ollama

OLLAMA_CHAT_MODEL=llama3.1:8b

# Leave unset to run Ollama-only; requests for provider=claude then return 503.
ANTHROPIC_API_KEY=
CLAUDE_CHAT_MODEL=claude-opus-5

# ─── Bring-your-own Anthropic key ──────────────────────────
# Users may supply their OWN Anthropic key, so their Claude usage is billed to
# them and never to you. The plaintext is never stored — only a hash and a
# fingerprint ("sk-ant-…AB12"). Details in .claude/rules/AUTH.md.
USER_ANTHROPIC_KEYS=true

# May a user WITHOUT their own key fall back to ANTHROPIC_API_KEY above?
#
# ** Set this to false before any public deploy. ** True means every visitor
# spends your Anthropic balance — the "open invoice" in .claude/rules/PLAN.md §6. It is
# true by default only so local development keeps working unchanged.
ALLOW_APP_KEY_FALLBACK=true

# ─── Public user id ────────────────────────────────────────
# HMAC key for the derived public handle (app/core/identity.py) — the one-way
# id used in URLs so an email never appears in a link.
# Generate:  python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# Falls back to SECRET_KEY when empty. Set it before publishing any link:
# otherwise rotating SECRET_KEY (which a token leak would force) silently
# changes every public id and breaks every URL.
IDENTITY_PEPPER=

LLM_MAX_TOKENS=1024

# ─── RAG ───────────────────────────────────────────────────
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K_RESULTS=5
MAX_UPLOAD_BYTES=10485760

# ─── CORS ──────────────────────────────────────────────────
# Comma-separated. The Next.js dev origin is added automatically when
# ENVIRONMENT=local, so this can stay empty in development.
BACKEND_CORS_ORIGINS=
