# ─── Secrets ───────────────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key

# ─── Reference projects ────────────────────────────────────
# related/ contains a checked-in virtualenv and (until rotated) live
# credentials in rag-fastapi-main/.env. Reference material only — never commit.
related/

